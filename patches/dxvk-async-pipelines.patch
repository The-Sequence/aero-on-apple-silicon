+  // Aero: persistent Vulkan pipeline cache. DXVK 3 has no state cache, so
+  // every boot recompiled the same Metal pipelines through MoltenVK.
+  // DXVK_PIPELINE_CACHE_FILE=<path> loads it at first use and rewrites it
+  // (atomically) after every few new pipelines.
+  static std::mutex           g_aeroCacheMutex;
+  static VkPipelineCache      g_aeroCache   = VK_NULL_HANDLE;
+  static std::atomic<uint32_t> g_aeroCacheNew = { 0u };
+
+  static const std::string& aeroCachePath() {
+    static const std::string path = env::getEnvVar("DXVK_PIPELINE_CACHE_FILE");
+    return path;
+  }
+
+  static VkPipelineCache aeroPipelineCache(const Rc<vk::DeviceFn>& vk) {
+    if (aeroCachePath().empty())
+      return VK_NULL_HANDLE;
+
+    std::lock_guard lock(g_aeroCacheMutex);
+
+    if (!g_aeroCache) {
+      std::vector<char> data;
+      std::ifstream in(aeroCachePath(), std::ios::binary);
+      if (in)
+        data.assign(std::istreambuf_iterator<char>(in), {});
+
+      VkPipelineCacheCreateInfo info = { VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO };
+      info.initialDataSize = data.size();
+      info.pInitialData    = data.empty() ? nullptr : data.data();
+
+      if (vk->vkCreatePipelineCache(vk->device(), &info, nullptr, &g_aeroCache)) {
+        info.initialDataSize = 0;
+        info.pInitialData    = nullptr;
+        if (vk->vkCreatePipelineCache(vk->device(), &info, nullptr, &g_aeroCache))
+          g_aeroCache = VK_NULL_HANDLE;
+      }
+
+      Logger::info(str::format("AERO-PIPELINE-CACHE loaded ", data.size(), " bytes"));
+    }
+
+    return g_aeroCache;
+  }
+
+  static void aeroPipelineCacheSave(const Rc<vk::DeviceFn>& vk) {
+    if (!g_aeroCache || (++g_aeroCacheNew % 4u) != 0u)
+      return;
+
+    std::lock_guard lock(g_aeroCacheMutex);
+    size_t size = 0;
+
+    if (vk->vkGetPipelineCacheData(vk->device(), g_aeroCache, &size, nullptr) || !size)
+      return;
+
+    std::vector<char> data(size);
+    if (vk->vkGetPipelineCacheData(vk->device(), g_aeroCache, &size, data.data()))
+      return;
+
+    std::string tmp = aeroCachePath() + ".tmp";
+    { std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+      out.write(data.data(), std::streamsize(size)); }
+    std::rename(tmp.c_str(), aeroCachePath().c_str());
+  }
+
+
+  static bool asyncPipelinesEnabled() {
+    static const bool enabled = env::getEnvVar("DXVK_ASYNC_PIPELINES") == "1";
+    return enabled;
+  }
+
+
+  static uint32_t asyncPipelineWaitMs() {
+    static const uint32_t ms = [] {
+      std::string v = env::getEnvVar("DXVK_ASYNC_WAIT_MS");
+      return v.empty() ? 150u : uint32_t(std::strtoul(v.c_str(), nullptr, 10));
+    }();
+    return ms;
+  }
