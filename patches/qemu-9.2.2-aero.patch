+static void vmsvga_trace_postblit_command(struct vmsvga_state_s *s,
+                                           uint32_t cmd)
+{
+    int64_t now = g_get_monotonic_time();
+
+    if (!vmsvga_trace_postblit_active(s, now)) {
+        return;
+    }
+    if (cmd == SVGA_CMD_DEFINE_CURSOR || cmd == SVGA_CMD_DEFINE_ALPHA_CURSOR ||
+        cmd == SVGA_CMD_MOVE_CURSOR || cmd == SVGA_CMD_DISPLAY_CURSOR) {
+        s->postblit_cursor_cmds++;
+    } else {
+        s->postblit_noncursor_cmds++;
+    }
+    if (s->postblit_last_summary_us == 0 ||
+        now - s->postblit_last_summary_us >= G_USEC_PER_SEC) {
+        fprintf(stderr,
+                "VMVGA-POSTBLIT-SUMMARY cursor=%" PRIu64
+                " noncursor=%" PRIu64 " next=0x%08x stop=0x%08x "
+                "fence=%u mask=0x%08x status=0x%08x sync=%u\n",
+                s->postblit_cursor_cmds, s->postblit_noncursor_cmds,
+                s->fifo_next, s->fifo_stop, s->fence, s->irq_mask,
+                s->irq_status, s->sync);
+        s->postblit_last_summary_us = now;
+        s->postblit_cursor_cmds = 0;
+        s->postblit_noncursor_cmds = 0;
+    }
+}
+
+static void vmsvga_trace_postblit_arm(struct vmsvga_state_s *s, uint32_t sid)
+{
+    int64_t now;
+
+    if (!vmsvga_trace_flight_enabled()) {
+        return;
+    }
+    now = g_get_monotonic_time();
+    s->postblit_trace_until_us = now + VMVGA_POSTBLIT_TRACE_US;
+    s->postblit_last_summary_us = 0;
+    s->postblit_cursor_cmds = 0;
+    s->postblit_noncursor_cmds = 0;
+    fprintf(stderr,
+            "VMVGA-POSTBLIT-ARM sid=%u window-us=%d fence=%u "
+            "next=0x%08x stop=0x%08x\n",
+            sid, VMVGA_POSTBLIT_TRACE_US, s->fence, s->fifo_next,
+            s->fifo_stop);
+}
