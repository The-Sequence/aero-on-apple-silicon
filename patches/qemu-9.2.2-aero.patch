+/* VMVGA_DYNAMIC_RES=1: when the host window is resized, ask VMware Tools in
+ * the guest (TCLO "Resolution_Set") to switch Windows to exactly that size,
+ * like Parallels/VMware Fusion, instead of scaling the old mode.  The UI
+ * layer already debounces while the user drags. */
+static void vmsvga_ui_info(void *opaque, uint32_t head, QemuUIInfo *info)
+{
+    static uint32_t last_w, last_h;
+    uint32_t w, h;
+    char *command;
+
+    (void)opaque;
+    if (head != 0 || info == NULL || info->width == 0 || info->height == 0) {
+        return;
+    }
+    w = MIN(MAX(info->width, 640u), (uint32_t)VMSVGA_MAX_WIDTH);
+    h = MIN(MAX(info->height, 480u), (uint32_t)VMSVGA_MAX_HEIGHT);
