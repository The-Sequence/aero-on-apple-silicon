+/* Capture the payload ABI used by VMware's signed Win7 DXVA driver. */
+static bool vmsvga3d_handle_video_probe(struct vmsvga_state_s *s,
+                                        uint32_t cmd, int32_t *len,
+                                        uint32_t fifo_start)
+{
+    void *payload;
+    uint32_t size;
+    uint32_t dump_size;
+    g_autofree char *hex = NULL;
+    char *out;
+    const uint8_t *bytes;
+    uint32_t i;
+
+    if (!vmsvga3d_fifo_read_payload(s, len, fifo_start, &payload, &size)) {
+        fprintf(stderr,
+                "VMVGA-VIDEO-PROBE cmd=%u fifo=0x%08x result=READ-FAIL\n",
+                cmd, fifo_start);
+        return true;
+    }
+
+    dump_size = MIN(size, 256u);
+    hex = g_malloc((size_t)dump_size * 3u + 1u);
+    out = hex;
+    bytes = payload;
+    for (i = 0; i < dump_size; i++) {
+        out += sprintf(out, "%02x%s", bytes[i],
+                       i + 1u == dump_size ? "" : " ");
+    }
+
+    fprintf(stderr,
+            "VMVGA-VIDEO-PROBE cmd=%u fifo=0x%08x bytes=%u prefix=%s%s\n",
+            cmd, fifo_start, size, hex, size > dump_size ? " ..." : "");
+    vmsvga3d_fifo_release_payload(s, payload);
+    return true;
+}
