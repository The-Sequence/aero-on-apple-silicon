+        src->hot_y != c->hot_y ||
+        src->and_mask_bpp != c->and_mask_bpp ||
+        src->xor_mask_bpp != c->xor_mask_bpp ||
+        src->and_size != and_size || src->xor_size != xor_size) {
+        return false;
+    }
