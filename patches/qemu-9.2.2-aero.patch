+void vmsvga3d_dxvk_vertex_declaration_destroy(void *declaration);
+bool vmsvga3d_dxvk_vertex_declaration_bind(VMSVGA3DDxvk *dxvk,
+                                           void *declaration);
+bool vmsvga3d_dxvk_set_stream_source(VMSVGA3DDxvk *dxvk, uint32_t stream,
