diff -ruN a/hw/display/meson.build b/hw/display/meson.build
--- a/hw/display/meson.build
+++ b/hw/display/meson.build
@@ -19,7 +19,19 @@
 system_ss.add(when: 'CONFIG_VGA_PCI', if_true: files('vga-pci.c'))
 system_ss.add(when: 'CONFIG_VGA_ISA', if_true: files('vga-isa.c'))
 system_ss.add(when: 'CONFIG_VGA_MMIO', if_true: files('vga-mmio.c'))
-system_ss.add(when: 'CONFIG_VMWARE_VGA', if_true: files('vmware_vga.c'))
+# NOTE (macOS port): of the nine vmvga .c files only vmware_vga.c is a real
+# translation unit - vmware_vga_3d.c #includes vmware_vga_dxvk{,_wsi}.c, and
+# vmware_vga.c in turn #includes gmr/3d. Registering the fragments separately
+# fails with undefined macros (VMVGA_TRACE_LOCAL) and missing types.
+# It also goes in specific_ss, not system_ss: the QEMU-9 compat header needs
+# cpu_physical_memory_set_dirty_range() from the target-specific ram_addr.h.
+specific_ss.add(when: 'CONFIG_VMWARE_VGA', if_true: files('vmware_vga.c'))
+# vmvga zero-copy overlay (macOS): Objective-C, needs SDL + Cocoa.
+if host_os == 'darwin' and sdl.found()
+  system_ss.add(when: 'CONFIG_VMWARE_VGA',
+                if_true: [files('vmware_vga_overlay.m'), sdl,
+                          dependency('appleframeworks', modules: ['Cocoa', 'QuartzCore'])])
+endif
 system_ss.add(when: 'CONFIG_BOCHS_DISPLAY', if_true: files('bochs-display.c'))
 
 system_ss.add(when: 'CONFIG_EXYNOS4', if_true: files('exynos4210_fimd.c'))
