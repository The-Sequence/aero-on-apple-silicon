+                    "VMVGA-SCREEN-HANDOFF phase=define duplicate-active=1 "
+                    "size=%ux%u/32/%u backing=%u:0x%08x\n",
+                    width, height, screen_stride, backing_gmr_id,
+                    backing_offset);
