+    if (and_size != 0 && memcmp(src->and_data, c->and_mask, and_size) != 0) {
+        return false;
+    }
+    if (xor_size != 0 && memcmp(src->xor_data, c->xor_mask, xor_size) != 0) {
+        return false;
