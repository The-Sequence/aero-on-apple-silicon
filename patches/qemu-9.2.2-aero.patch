+            &copy_structure_count, sizeof(copy_structure_count))) {
+        return false;
+    }
+
+    copy_structure_count(dxvk->d3d11_context, destination_buffer,
+                         destination_byte_offset, source_view);
+
+    return true;
+#else
+    (void)dxvk;
+    (void)destination;
+    (void)destination_byte_offset;
+    (void)cid;
+    (void)source_view_id;
