+static bool vmsvga3d_query_write_result(struct vmsvga_state_s *s,
+                                          const SVGAGuestPtr *guest_result,
+                                          SVGA3dQueryState state,
+                                          uint32_t result)
+{
+    SVGA3dQueryResult query_result = {
+          .totalSize = sizeof(SVGA3dQueryResult),
+          .state = state,
+          .result32 = result,
+    };
+
+    if (guest_result == NULL) {
+        return false;
+    }
+
+    SVGA3dQueryResult verify = { 0 };
+    bool write_ok;
+    bool read_ok;
+
+    write_ok = vmsvga_gmr_write(s, guest_result->gmrId, guest_result->offset,
+                                &query_result, sizeof(query_result));
+    read_ok = write_ok &&
+              vmsvga_gmr_read(s, guest_result->gmrId, guest_result->offset,
+                              &verify, sizeof(verify));
+    if (vmsvga_trace_flight_enabled()) {
+        fprintf(stderr,
+                "VMVGA-QUERY-PUBLISH guest=%u:0x%08x write=%s readback=%s "
+                "expected-state=%u verify-size=%u verify-state=%u "
+                "verify-result=%u\n",
+                guest_result->gmrId, guest_result->offset,
+                write_ok ? "OK" : "FAIL", read_ok ? "OK" : "FAIL",
+                (uint32_t)state, read_ok ? verify.totalSize : 0,
+                read_ok ? (uint32_t)verify.state : UINT32_MAX,
+                read_ok ? verify.result32 : 0);
+    }
+    return write_ok;
+}
