+static void vmsvga3d_surface_free(VMSVGA3DSurface *surface)
+{
+    VMSVGA3DD3D9TransferSurface d3d9_info = { 0 };
+    bool have_d3d9_info;
+    uint32_t i;
+
+    if (surface == NULL) {
+        return;
+    }
+
+    have_d3d9_info = vmsvga3d_dxvk_surface_info(surface->dxvk_surface,
+                                                &d3d9_info);
+    fprintf(stderr,
+            "VMVGA-RESOURCE-LIFETIME destroy sid=%u format=%u "
+            "size=%ux%ux%u mips=%u bytes=%zu dxvk=%p bridge=%p "
+            "d3d9-info=%u resident=%u bounce=%u resource-type=%u\n",
+            surface->sid, surface->format,
+            surface->mip_count != 0 ? surface->mips[0].size.width : 0,
+            surface->mip_count != 0 ? surface->mips[0].size.height : 0,
+            surface->mip_count != 0 ? surface->mips[0].size.depth : 0,
+            surface->mip_count, surface->storage_bytes,
+            (void *)surface->dxvk_surface,
+            (void *)surface->present_d3d9_bridge,
+            have_d3d9_info, have_d3d9_info && d3d9_info.resident,
+            have_d3d9_info && d3d9_info.has_bounce,
+            have_d3d9_info ? d3d9_info.resource_type : 0);
+
+    vmsvga3d_dxvk_surface_destroy(surface->present_d3d9_bridge);
+    surface->present_d3d9_bridge = NULL;
+    vmsvga3d_dxvk_surface_destroy(surface->dxvk_surface);
+    surface->dxvk_surface = NULL;
+
+    for (i = 0; i < surface->mip_count; i++) {
+        g_free(surface->mips[i].data);
+    }
+
+    g_free(surface->mips);
+    g_free(surface);
+}
