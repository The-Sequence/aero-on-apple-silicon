+static const char *vmsvga3d_d3d9_execution_name(
+    VMSVGA3DD3D9ExecutionPreference execution)
+{
+    switch (execution) {
+    case VMSVGA3D_D3D9_EXECUTION_CPU_ONLY:
+        return "cpu";
+    case VMSVGA3D_D3D9_EXECUTION_GPU_PREFERRED:
+        return "gpu-preferred";
+    default:
+        return "invalid";
+    }
+}
