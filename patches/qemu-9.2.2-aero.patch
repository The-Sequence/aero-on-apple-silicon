+#ifdef VERBOSE
+    cursor_print_ascii_art(qc, src->alpha ? "vmsvga_alpha" : "vmsvga_cursor");
 #endif
 
+    vmsvga_cursor_cache_put(s, id, qc);
+
+    return true;
+}
