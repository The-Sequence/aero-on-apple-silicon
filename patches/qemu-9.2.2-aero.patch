+
+    memset(dxvk->d3d9_bound_stream_sources, 0,
+           sizeof(dxvk->d3d9_bound_stream_sources));
+    memset(dxvk->d3d9_bound_stream_offsets, 0,
+           sizeof(dxvk->d3d9_bound_stream_offsets));
