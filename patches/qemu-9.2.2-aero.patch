diff -ruN a/audio/coreaudio.m b/audio/coreaudio.m
--- a/audio/coreaudio.m
+++ b/audio/coreaudio.m
@@ -322,14 +322,30 @@
         return 0;
     }
 
-    frameCount = core->audioDevicePropertyBufferFrameSize;
+    if (outOutputData->mNumberBuffers < 1 || !out) {
+        coreaudio_buf_unlock (core, "audioDeviceIOProc(no buffer)");
+        return 0;
+    }
+
+    /*
+     * Fill exactly the buffer CoreAudio handed us.  audioDevicePropertyBuffer-
+     * FrameSize is only the size we *requested*; the HAL may call with fewer
+     * frames (different device rate, aggregate or Bluetooth devices, a size
+     * it clamped).  Copying the requested count drained the guest's audio
+     * faster than it played (sped-up, pitched-up sound, and media players
+     * that slave video to the audio clock raced along with it) and wrote
+     * past the end of the HAL's buffer.
+     */
+    frameCount = outOutputData->mBuffers[0].mDataByteSize / hw->info.bytes_per_frame;
     pending_frames = hw->pending_emul / hw->info.bytes_per_frame;
 
-    /* if there are not enough samples, set signal and return */
+    /* if there are not enough samples, play what there is and pad with silence */
     if (pending_frames < frameCount) {
-        inInputTime = 0;
-        coreaudio_buf_unlock (core, "audioDeviceIOProc(empty)");
-        return 0;
+        size_t silence = (size_t)(frameCount - pending_frames) * hw->info.bytes_per_frame;
+
+        memset((char *)out + (size_t)pending_frames * hw->info.bytes_per_frame,
+               0, silence);
+        frameCount = pending_frames;
     }
 
     len = frameCount * hw->info.bytes_per_frame;
diff -ruN a/hw/audio/hda-codec.c b/hw/audio/hda-codec.c
--- a/hw/audio/hda-codec.c
+++ b/hw/audio/hda-codec.c
@@ -167,7 +167,12 @@
     } voice;
     uint8_t compat_buf[HDA_BUFFER_SIZE];
     uint32_t compat_bpos;
-    uint8_t buf[8192]; /* size must be power of two */
+    /* size must be power of two.  32 KiB (~186 ms at 44.1 kHz stereo
+     * s16) instead of 8 KiB: under TCG the audio callback often runs late,
+     * and a full FIFO is dropped whole (hda_audio_overrun) after the guest's
+     * DMA position has already advanced, so media players skipped ahead and
+     * played too fast. */
+    uint8_t buf[32768];
     int64_t rpos;
     int64_t wpos;
     QEMUTimer *buft;
