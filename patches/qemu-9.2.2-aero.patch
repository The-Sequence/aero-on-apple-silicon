+static void vmsvga3d_dxvk_d3d9_legacy_present_reset(
+    VMSVGA3DDxvk *dxvk)
+{
+    if (dxvk == NULL) {
+        return;
+    }
+
+#if (defined(CONFIG_LINUX) && defined(__ELF__)) || defined(__APPLE__)
