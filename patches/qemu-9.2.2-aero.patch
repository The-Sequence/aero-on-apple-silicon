+    if (!vmsvga3d_dxvk_wsi_valid_window(wsi)) {
+        vmsvga3d_dxvk_wsi_set_error("invalid synthetic window");
+        if (width != NULL) {
+            *width = 0;
+        }
+        if (height != NULL) {
+            *height = 0;
+        }
+        return;
