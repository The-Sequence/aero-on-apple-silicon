+static bool vmsvga_handle_destroy_gb_surface(struct vmsvga_state_s *s,
+                                             uint32_t cmd, int32_t *len,
+                                             uint32_t fifo_start)
+{
+    if (s != NULL && !s->svga3d_capable) {
+        return vmsvga2d_handle_destroy_gb_surface(s, cmd, len, fifo_start);
