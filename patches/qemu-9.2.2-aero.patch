+/* Where the DXVK dylibs and the WSI shim live, resolved at run time so a
+ * release build is relocatable: $VMVGA_LIBDIR, then <exe dir>/../lib, then
+ * <exe dir>, then the build-time VMSVGA3D_LIB_FALLBACK_DIR.  Returns a
+ * malloc'd full path for leaf (never freed; a handful of calls per run). */
+#ifndef VMSVGA3D_LIB_FALLBACK_DIR
+#define VMSVGA3D_LIB_FALLBACK_DIR "/usr/local/lib/vmvga"
+#endif
+static char *vmsvga3d_macos_lib(const char *leaf)
+{
+    char exe[PATH_MAX], real[PATH_MAX];
+    uint32_t size = sizeof(exe);
+    const char *env = getenv("VMVGA_LIBDIR");
+    struct stat st;
+    char *p;
+
+    if (env != NULL && env[0] != '\0') {
+        p = g_strdup_printf("%s/%s", env, leaf);
+        if (stat(p, &st) == 0) {
+            return p;
+        }
+        g_free(p);
+    }
+    if (_NSGetExecutablePath(exe, &size) == 0 && realpath(exe, real) != NULL) {
+        char *dir = g_path_get_dirname(real);
+
+        p = g_strdup_printf("%s/../lib/%s", dir, leaf);
+        if (stat(p, &st) == 0) {
+            g_free(dir);
+            return p;
+        }
+        g_free(p);
+        p = g_strdup_printf("%s/%s", dir, leaf);
+        g_free(dir);
+        if (stat(p, &st) == 0) {
+            return p;
+        }
+        g_free(p);
+    }
+    return g_strdup_printf("%s/%s", VMSVGA3D_LIB_FALLBACK_DIR, leaf);
+}
