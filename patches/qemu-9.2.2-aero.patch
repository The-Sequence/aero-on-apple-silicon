+typedef struct VMSVGA3DTransitionCapture {
+    const char *directory;
+    uint64_t sequence;
+    uint64_t dumps;
+    uint64_t captured_bytes;
+    uint64_t state_changes;
+    uint64_t preserve_attempts;
+    uint64_t preserve_failures;
+    uint64_t forced_full_presents;
+    uint64_t invalid_blits;
+    bool initialized;
+} VMSVGA3DTransitionCapture;
+
+static VMSVGA3DTransitionCapture vmsvga3d_transition_capture;
+
+static const char *vmsvga3d_content_owner_name(VMSVGA3DContentOwner owner)
+{
+    switch (owner) {
+    case VMSVGA3D_CONTENT_CPU: return "cpu";
+    case VMSVGA3D_CONTENT_D3D9: return "d3d9";
+    case VMSVGA3D_CONTENT_D3D11: return "d3d11";
+    case VMSVGA3D_CONTENT_SYNCHRONIZED: return "synchronized";
+    default: return "undefined";
+    }
+}
+
+static void vmsvga3d_transition_capture_summary(void)
+{
+    VMSVGA3DTransitionCapture *capture = &vmsvga3d_transition_capture;
+
+    if (!capture->initialized) {
+        return;
+    }
+    fprintf(stderr,
+            "VMVGA-TRANSITION-SUMMARY events=%" PRIu64 " dumps=%" PRIu64
+            " bytes=%" PRIu64
+            " state-changes=%" PRIu64 " preserve=%" PRIu64
+            " preserve-fail=%" PRIu64 " forced-full=%" PRIu64
+            " invalid-blits=%" PRIu64 "\n",
+            capture->sequence, capture->dumps, capture->captured_bytes,
+            capture->state_changes,
+            capture->preserve_attempts, capture->preserve_failures,
+            capture->forced_full_presents, capture->invalid_blits);
+}
+
+static VMSVGA3DTransitionCapture *vmsvga3d_transition_capture_get(void)
+{
+    VMSVGA3DTransitionCapture *capture = &vmsvga3d_transition_capture;
+
+    if (!capture->initialized) {
+        capture->directory = getenv("VMVGA_TRANSITION_CAPTURE");
+        capture->initialized = true;
+        if (capture->directory != NULL && capture->directory[0] != '\0') {
+            g_mkdir_with_parents(capture->directory, 0755);
+            atexit(vmsvga3d_transition_capture_summary);
+            fprintf(stderr, "VMVGA-TRANSITION-CAPTURE directory=%s "
+                    "limit=64/134217728\n",
+                    capture->directory);
+        }
+    }
+    return capture;
+}
+
+static void vmsvga3d_content_set(VMSVGA3DSurface *surface,
+                                 uint32_t subresource,
+                                 VMSVGA3DContentOwner owner,
+                                 const char *reason)
+{
+    VMSVGA3DTransitionCapture *capture = vmsvga3d_transition_capture_get();
+    VMSVGA3DSurfaceImage *image;
+
+    if (surface == NULL || surface->mips == NULL ||
+        subresource >= surface->mip_count) {
+        return;
+    }
+    image = &surface->mips[subresource];
+    if (image->content_owner == owner) {
+        return;
+    }
+    image->content_owner = owner;
+    capture->state_changes++;
+    if (capture->directory != NULL && capture->directory[0] != '\0') {
+        fprintf(stderr,
+                "VMVGA-CONTENT-STATE seq=%" PRIu64 " sid=%u sub=%u owner=%s "
+                "reason=%s\n", ++capture->sequence, surface->sid, subresource,
+                vmsvga3d_content_owner_name(owner),
+                reason != NULL ? reason : "unknown");
+    }
+}
+
+static void vmsvga3d_transition_dump(VMSVGA3DSurface *surface,
+                                     uint32_t subresource,
+                                     const char *stage)
+{
+    VMSVGA3DTransitionCapture *capture = vmsvga3d_transition_capture_get();
+    VMSVGA3DSurfaceImage *image;
+    g_autofree char *name = NULL;
+    g_autofree char *meta = NULL;
+    g_autofree char *meta_name = NULL;
+    uint32_t hash = UINT32_C(2166136261);
+    uint32_t i;
+
+    if (capture->directory == NULL || capture->directory[0] == '\0' ||
+        capture->dumps >= 64 || surface == NULL || surface->mips == NULL ||
+        subresource >= surface->mip_count || stage == NULL) {
+        return;
+    }
+    image = &surface->mips[subresource];
+    if (image->data == NULL || image->data_size == 0) {
+        return;
+    }
+    if (capture->captured_bytes >= 128u * 1024u * 1024u ||
+        image->data_size > 128u * 1024u * 1024u - capture->captured_bytes) {
+        return;
+    }
+    capture->sequence++;
+    capture->dumps++;
+    capture->captured_bytes += image->data_size;
+    for (i = 0; i < image->data_size; i++) {
+        hash ^= image->data[i];
+        hash *= UINT32_C(16777619);
+    }
+    name = g_strdup_printf("%s/%06" PRIu64 "_%s_sid%u_sub%u.bgra",
+                           capture->directory, capture->sequence, stage,
+                           surface->sid, subresource);
+    meta_name = g_strdup_printf("%s.txt", name);
+    meta = g_strdup_printf("sid=%u\nsubresource=%u\nstage=%s\nowner=%s\n"
+                           "format=%u\nwidth=%u\nheight=%u\ndepth=%u\n"
+                           "pitch=%u\nbytes=%u\nhash=0x%08x\n",
+                           surface->sid, subresource, stage,
+                           vmsvga3d_content_owner_name(image->content_owner),
+                           surface->format, image->size.width,
+                           image->size.height, image->size.depth, image->pitch,
+                           image->data_size, hash);
+    if (!g_file_set_contents(name, (const char *)image->data,
+                             image->data_size, NULL) ||
+        !g_file_set_contents(meta_name, meta, -1, NULL)) {
+        fprintf(stderr, "VMVGA-TRANSITION-DUMP seq=%" PRIu64
+                " stage=%s sid=%u result=FAIL\n", capture->sequence, stage,
+                surface->sid);
+        return;
+    }
+    fprintf(stderr, "VMVGA-TRANSITION-DUMP seq=%" PRIu64
+            " stage=%s sid=%u sub=%u owner=%s hash=0x%08x result=OK\n",
+            capture->sequence, stage, surface->sid, subresource,
+            vmsvga3d_content_owner_name(image->content_owner), hash);
+}
