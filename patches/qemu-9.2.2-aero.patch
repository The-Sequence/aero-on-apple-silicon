+    }
+
+    link = &dxvk->d3d11_shaders;
+
+    while (*link != NULL) {
+        VMSVGA3DDxvkShader *shader = *link;
+
+        if (shader->cid != cid) {
+            link = &shader->next;
+            continue;
+        }
+        *link = shader->next;
+        vmsvga3d_dxvk_d3d11_shader_free(shader);
