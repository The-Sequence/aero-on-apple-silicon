+/* VMVGA smart replay: bumped by every SVGA3D command that is not a plain
+ * state-set or draw (surface copies/DMAs/blits/presents/clears/queries/...)
+ * and by each display refresh, i.e. by anything that may touch the native
+ * D3D9 device behind the context's dirty tracking.  A forced replay
+ * (VMVGA_REPLAY_MASK / FULL_REPLAY) is then only needed for the first draw
+ * after such a command, not for every draw. */
+static uint64_t vmsvga3d_native_epoch = 1;
+
+/* VMVGA-PROFILE-CMD: host time per SVGA3D command id (relative to
+ * SVGA_3D_CMD_LEGACY_BASE; last slot = everything else), top 6 printed with
+ * the 1 s profile. */
+#define VMSVGA3D_CMD_PROF_SLOTS 256
+static uint64_t vmsvga3d_cmd_prof_us[VMSVGA3D_CMD_PROF_SLOTS];
+static uint64_t vmsvga3d_cmd_prof_n[VMSVGA3D_CMD_PROF_SLOTS];
+
+static void vmsvga3d_cmd_prof_report(void)
+{
+    int i, k, best;
+    char line[768];
+    size_t n = 0;
+
+    line[0] = 0;
+    for (k = 0; k < 6; k++) {
+        best = -1;
+        for (i = 0; i < VMSVGA3D_CMD_PROF_SLOTS; i++) {
+            if (vmsvga3d_cmd_prof_us[i] != 0 &&
+                (best < 0 || vmsvga3d_cmd_prof_us[i] > vmsvga3d_cmd_prof_us[best])) {
+                best = i;
+            }
+        }
+        if (best < 0) {
+            break;
+        }
+        n += (size_t)snprintf(line + n, sizeof(line) - n,
+                              " cmd%d=%" PRIu64 "us/%" PRIu64,
+                              best + SVGA_3D_CMD_LEGACY_BASE,
+                              vmsvga3d_cmd_prof_us[best],
+                              vmsvga3d_cmd_prof_n[best]);
+        vmsvga3d_cmd_prof_us[best] = 0;
+        if (n >= sizeof(line)) {
+            break;
+        }
+    }
+    memset(vmsvga3d_cmd_prof_us, 0, sizeof(vmsvga3d_cmd_prof_us));
+    memset(vmsvga3d_cmd_prof_n, 0, sizeof(vmsvga3d_cmd_prof_n));
+    if (line[0]) {
+        fprintf(stderr, "VMVGA-PROFILE-CMD%s\n", line);
+    }
+}
