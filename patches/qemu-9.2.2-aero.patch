+            now - (s->postblit_trace_until_us - VMVGA_POSTBLIT_TRACE_US),
+            reg, access, value, fifo_min, fifo_max, fifo_next, fifo_stop,
+            fifo_busy, fifo_fence, fifo_goal, s->fence, s->fence_goal,
+            s->irq_mask, s->irq_status, s->sync);
+}
