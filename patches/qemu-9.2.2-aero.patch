+static void vmsvga3d_dxvk_sdl_fill_mode(VMSVGA3DDxvkSdlDisplayMode *mode,
+                                         int width, int height,
+                                         int refresh_rate)
+{
+    mode->format = VMSVGA3D_DXVK_SDL_PIXELFORMAT_32BPP;
